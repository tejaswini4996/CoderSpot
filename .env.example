# Copy this file to .env and fill in real values. Never commit the real
# .env file — it holds passwords.

# A long random string used to sign login sessions and unsubscribe links.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Gmail account used to send the monthly newsletter.
# GMAIL_APP_PASSWORD must be an App Password (not your normal Gmail
# password) — see email_utils.py for setup steps.
GMAIL_ADDRESS=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16characterapppassword

# Optional: "Continue with Google/GitHub" login for visitors. Leave
# blank/unset to hide those buttons entirely — see oauth.py for the full
# setup steps (you need to register an OAuth app with each provider).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
